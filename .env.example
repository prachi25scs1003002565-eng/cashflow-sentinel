# Cashflow Sentinel — Environment Configuration
# Copy this file to .env in cashflow-sentinel/

# Node Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1

# Security & Authentication
# Generate separate secrets with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_unique_64_character_hex_secret
JWT_EXPIRES_IN=900
CORS_ORIGIN=http://localhost:3000

# Private Analytics Service Authentication
# Shared secret between Express backend and FastAPI analytics service
ANALYTICS_SERVICE_URL=http://127.0.0.1:8000
ANALYTICS_SERVICE_TOKEN=replace_with_a_different_64_character_hex_secret
ANALYTICS_TIMEOUT_MS=10000

# PostgreSQL Database Configuration
# Option A (Recommended for Cloud / Hosted DB): Full connection URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#
# Option B (Local / Individual Parameters):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cashflow_sentinel
DB_USER=postgres
DB_PASSWORD=replace_with_local_postgres_password

# Database SSL Configuration
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=replace_with_optional_ca_certificate_pem_content

# Connection Pooling
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api/v1
